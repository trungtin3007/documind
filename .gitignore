# secrets
.env

# virtualenvs
venv/
venv_py39_old/

# python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# source document: third-party copyrighted paper, not redistributed here.
# See README for the arXiv source and how to regenerate pages/ and index/.
sample.pdf

# Demo corpus. The TRIMMED corpus (pages_demo/, index_demo/ — 194 pages, ~57MB)
# IS committed: it is US federal public-domain material and it is what the
# deployed demo serves. The full 611-page corpus and the source PDFs are not —
# too large for git, and regenerable (see README).
sources/
pages_demo_full/
index_demo_full/

# generated: page images rendered from sample.pdf (pdf_to_images.py)
pages/

# generated: full text layer of sample.pdf (extract_text.py). Excluded for the
# same reason as sample.pdf itself — it is the whole third-party paper, just in
# another format — and it is regenerable from the PDF.
pages_text.json

# generated: embeddings + page manifest (build_index.py)
index/

# generated: diagnostic and verification image bundles
results/
verify/

# scratch
*.log
.DS_Store
