# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- required: the answering + retrieval APIs -------------------------------
VOYAGE_API_KEY=your-voyage-key-here
GEMINI_API_KEY=your-gemini-key-here

# --- optional: Cloudflare R2, for durable storage of user uploads -----------
# When all four are set, uploads are stored in R2 and survive restarts and
# redeploys. When any is missing the app falls back to local disk (uploads/),
# which is fine for local development but is lost on a Render restart.
# The fixed demo corpus and the evaluation corpus never use R2 — they are
# committed local files.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-bucket-name

# --- optional: runtime switches ---------------------------------------------
# DOCUMIND_DATA=demo                     # which corpus to serve (single|demo|demo-full)
# DOCUMIND_METHOD=hybrid-bm25            # visual | hybrid-bm25 | hybrid-embedding
# DOCUMIND_ANSWER_MODEL=gemini-3.6-flash # override the answering model
